{
    "name": "blitz-php/coding-standard",
    "type": "library",
    "description": "Normes de codage officielles pour Blitz PHP basées sur PHP CS Fixer",
    "license": "MIT",
    "keywords": [
        "phpcs",
        "static analysis"
    ],
    "authors": [
        {
            "name": "Dimitri Sitchet Tomkeu",
            "email": "devcode.dst@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-tokenizer": "*",
        "friendsofphp/php-cs-fixer": "^3.94",
        "nexusphp/cs-config": "^3.28"
    },
    "require-dev": {
        "nexusphp/tachycardia": "^2.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "BlitzPHP\\CodingStandard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlitzPHP\\CodingStandard\\Tests\\": "tests/"
        }
    },
   "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "forum": "https://blitz-php.byethost14.com/goto/forum",
        "source": "https://github.com/blitz-php/coding-standard"
    }
}
